# Base URL backend Laravel (tanpa trailing slash berlebihan; path /api disertakan di sini)
# Salin file ini ke `.env` dan sesuaikan:
#   cp .env.example .env
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Link invite grup WhatsApp tagihan (bukan nomor pribadi pelanggan)
# Dapatkan dari: Grup WA → Info grup → Undang via link
# NUXT_PUBLIC_WA_GROUP_LINK=https://chat.whatsapp.com/xxxxxxxxxx
